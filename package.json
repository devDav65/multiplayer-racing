{
  "name": "multiplayer-racing",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "pnpm --filter @racing/client build",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose up -d --wait db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @racing/server db:migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
