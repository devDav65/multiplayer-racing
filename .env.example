# Copier en .env (ignoré par Git) et adapter.

# Serveur
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
# RACE_LAPS=1   # courses courtes pour le développement

# PostgreSQL (docker compose up -d db). Sans DATABASE_URL, le serveur tourne sans comptes.
POSTGRES_USER=racing
POSTGRES_PASSWORD=racing
POSTGRES_DB=racing
DATABASE_URL=postgres://racing:racing@localhost:5433/racing
TEST_DATABASE_URL=postgres://racing:racing@localhost:5433/racing_test
